#!/usr/bin/env -S python3 -I
"""Stub llama-server for the serve_qwen_agent.sh tests (no model): answers /health, /v1/models and /props in b11742's
format on 127.0.0.1:--port. Env: STUB_DIE=1 (exit 1 at once), STUB_DELAY (seconds of 503 "Loading model" before /health
is ok), STUB_NCTX (report this n_ctx per slot instead of -c / -np), STUB_IDS (comma-separated ids instead of -a),
STUB_BUILD (build_info instead of the real server's b1-4c3c581)."""
import json
import os
import signal
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

argv = sys.argv[1:]


def opt(name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default


port, alias = int(opt("--port")), opt("-a", "model")
n_slots, n_ctx = int(opt("-np", "1")), int(opt("-c", "4096"))
if os.environ.get("STUB_DIE") == "1":
    print("stub: failing at start", flush=True)
    sys.exit(1)
t0, delay = time.time(), float(os.environ.get("STUB_DELAY", "0"))
ids = os.environ.get("STUB_IDS", alias).split(",")
slot_ctx = int(os.environ.get("STUB_NCTX", n_ctx // n_slots))


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if time.time() - t0 < delay:
            return self.send(503, {"error": {"code": 503, "message": "Loading model", "type": "unavailable_error"}})
        if self.path == "/health":
            return self.send(200, {"status": "ok"})
        if self.path == "/v1/models":
            return self.send(200, {"object": "list", "data": [{"id": i, "object": "model"} for i in ids]})
        if self.path == "/props":
            return self.send(200, {"total_slots": n_slots, "default_generation_settings": {"n_ctx": slot_ctx},
                                   "build_info": os.environ.get("STUB_BUILD", "b1-4c3c581"),
                                   "model_path": opt("-m")})
        return self.send(404, {"error": "not found"})


signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
print(f"stub: listening on 127.0.0.1:{port}", flush=True)
ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
