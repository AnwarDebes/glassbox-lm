+def train_inclusive(gain, bn, train_sd=TRAIN_SD_GAIN):
+    """gain +- 1.96 sqrt(se_b^2 + train_sd^2), se_b the block-bootstrap SD of bits(code) - bits(none)
+    carried to the gain by the delta method (se_b = boot_sd ln2 2^mean); no rule."""
+    se_b = bn["boot_sd"] * np.log(2) * 2 ** bn["mean"]
+    half = 1.96 * float(np.sqrt(se_b ** 2 + train_sd ** 2))
+    return {"lo": float(gain - half), "hi": float(gain + half), "se_blocks": float(se_b), "train_sd": train_sd}
