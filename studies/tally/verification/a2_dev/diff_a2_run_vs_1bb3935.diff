+def locked_versions(study):
+    """name -> version pinned in the lock file of .venv-tm (lines name==version)."""
+    out = {}
+    with open(os.path.join(study, LOCK_FILE)) as f:
+        for line in f:
+            line = line.split("#")[0].strip()
+            if "==" in line:
+                k, v = line.split("==", 1)
+                out[k.strip().lower()] = v.strip()
+    return out
+
