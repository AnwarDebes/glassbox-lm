+def environment_differences(study):
+    """Thread settings, NLTK_DATA and installed versions that differ from the development runs and the lock."""
+    errs = [f"{k} is {os.environ.get(k)!r}, the development runs used {LOOK_THREADS}"
+            for k in THREAD_VARS if os.environ.get(k) != LOOK_THREADS]
+    if os.environ.get("NLTK_DATA"):
+        errs.append("NLTK_DATA is set; the look reads only the pinned nltk_data")
+    try:
+        lock = locked_versions(study)
+    except OSError:
+        return errs + [f"lock file missing: {LOCK_FILE}"]
+    for pkg in LOCKED:
+        try:
+            have = importlib.metadata.version(pkg)
+        except importlib.metadata.PackageNotFoundError:
+            have = None
+        if have != lock.get(pkg):
+            errs.append(f"{pkg} {have} installed, {lock.get(pkg)} in {LOCK_FILE}")
+    return errs
