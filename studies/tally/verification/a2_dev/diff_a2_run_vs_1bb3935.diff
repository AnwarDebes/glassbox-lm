+def sha256_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def src_hashes(study):
+    """sha256 of every file under study/src that the freeze record covers, keyed as freeze.py keys them."""
+    out = {}
+    for d, dirs, files in os.walk(os.path.join(study, "src")):
+        dirs[:] = sorted(x for x in dirs if x != "__pycache__")
+        for f in sorted(files):
+            if f.endswith(SRC_EXT):
+                p = os.path.join(d, f)
+                out[os.path.relpath(p, study)] = sha256_file(p)
+    return out
+
+
+def code_files():
+    return [os.path.join("data", "a2_codes", f"{n}{e}") for n in CODE_NAMES for e in (".npy", ".json")]
+
+
+def data_files_of():
+    """The data files the run reads, as paths relative to the study folder (as freeze.py keys them)."""
+    ext = [os.path.join(codes.EXTERNAL, *p) for p in (
+        ("simlex999", "SimLex-999.zip"), ("wordsim353", "wordsim353.zip"),
+        ("nltk_data", "corpora", "brown.zip"), ("nltk_data", "taggers", "universal_tagset.zip"))]
+    files = [ptb.path("train"), ptb.path("valid"), *ext, os.path.join(codes.WORDNET_DIR, "corpora", "wordnet.zip"),
+             codes.ORGROUPS_FILE]
+    return [os.path.relpath(p, HOME_STUDY) for p in files]
