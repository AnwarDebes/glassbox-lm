+def check_record(rec, study, required_extra):
+    """Differences between the freeze record and the files under study (empty list: all equal)."""
+    errs = []
+    reg = rec.get("registration", {})
+    if list(reg) != [REGISTRATION]:
+        errs.append(f"the record is not the record of {REGISTRATION}: {list(reg)}")
+    for p, h in reg.items():
+        f = os.path.join(study, p)
+        if not os.path.exists(f) or sha256_file(f) != h:
+            errs.append(f"changed after the freeze: {p}")
+    now = src_hashes(study)
+    for p in sorted(set(now) | set(rec.get("src", {}))):
+        if now.get(p) != rec.get("src", {}).get(p):
+            errs.append(f"src differs from the freeze record: {p}")
+    extra = rec.get("extra", {})
+    for p in required_extra:
+        if p not in extra:
+            errs.append(f"not pinned as an extra file: {p}")
+    for p, h in extra.items():
+        f = os.path.join(study, p)
+        if not os.path.exists(f) or sha256_file(f) != h:
+            errs.append(f"changed after the freeze: {p}")
+    return errs
+
